# Kingsway Academy Environment Configuration
# 
# IMPORTANT: This file contains secrets and should NEVER be committed to git!
# Copy this file to .env and update with your actual credentials

# Environment: development, staging, production
APP_ENV=development

# Debug Mode (true for development, false for production)
DEBUG=true

# Base URL
BASE_URL=http://localhost/Kingsway

# Trusted reverse-proxy IPv4/IPv6 CIDRs, comma-separated.
# Leave empty for direct Apache/XAMPP deployments.
TRUSTED_PROXY_CIDRS=

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_NAME=KingsWayAcademy
DB_PORT=3306
DB_PASS=your_local_db_password

# JWT Configuration (MUST be 64+ random characters in production!)
JWT_SECRET=dev_jwt_secret_change_this_in_production_to_64_chars_minimum
JWT_EXPIRY=3600
JWT_ISSUER=kingsway-prep-school
JWT_AUDIENCE=kingsway-staff
TFA_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
PASSKEY_RP_ID=localhost
AUTH_IDLE_TIMEOUT_SECONDS=1800
AUTH_REFRESH_WINDOW_SECONDS=600
AUTH_SESSION_MONITOR_INTERVAL_SECONDS=30

# Email Configuration
SMTP_HOST=mail.kingswaypreparatoryschool.sc.ke
SMTP_PORT=587
SMTP_USERNAME=info@kingswaypreparatoryschool.sc.ke
SMTP_FROM_EMAIL=info@kingswaypreparatoryschool.sc.ke
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_NAME=Kingsway Preparatory School

# SMS Configuration (Africa's Talking)
SMS_PROVIDER=africastalking
SMS_API_KEY=your_sms_api_key_here
SMS_USERNAME=sandbox
SMS_APPNAME=Sandbox
SMS_SENDER_ID=Kingsway Preparatory
SMS_SHORTCODE=20174
SMS_WHATSAPP_NUMBER=+254710398690
SMS_WHATSAPP_API_URL=https://chat.africastalking.com

# Communication callback/worker credentials (generate unique production secrets)
COMMUNICATION_WEBHOOK_SECRET=replace_with_provider_webhook_secret
AFRICASTALKING_WEBHOOK_TOKEN=replace_with_long_random_token
WHATSAPP_2FA_TEMPLATE_ID=approved_africastalking_authentication_template_id
COMMUNICATION_WORKER_SECRET=replace_with_internal_worker_secret

# M-Pesa Configuration
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_paybill_number
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_SECURITY_CREDENTIAL=your_encrypted_security_credential
# Callback URLs handed to Safaricom must be publicly reachable HTTPS. There is
# no subdomain in the picture — use the same root domain as the site. In
# sandbox, localhost cannot be reached by Safaricom, so point this at the
# public domain (e.g. https://kingswaypreparatoryschool.sc.ke). On production
# leave it unset so it falls back to BASE_URL automatically.
# MPESA_CALLBACK_BASE_URL=https://kingswaypreparatoryschool.sc.ke

# KCB Bank Buni Configuration
KCB_ENVIRONMENT=sandbox
KCB_BASE_URL=https://uat.buni.kcbgroup.com
KCB_TOKEN_ENDPOINT=https://accounts.buni.kcbgroup.com/oauth2/token
KCB_REVOKE_ENDPOINT=https://accounts.buni.kcbgroup.com/oauth2/revoke
KCB_CONSUMER_KEY=your_kcb_consumer_key
KCB_CONSUMER_SECRET=your_kcb_consumer_secret
KCB_API_KEY=your_kcb_api_key
KCB_ORGANIZATION_REFERENCE=your_org_reference
KCB_COLLECTION_ACCOUNT_IDENTIFIER=issued_by_kcb
KCB_DEBIT_ACCOUNT=school_source_account_for_outbound_transfers
# Kept only for legacy compatibility; do not use as the source account.
KCB_CREDIT_ACCOUNT=
KCB_CALLBACK_BASE_URL=https://kingswaypreparatoryschool.sc.ke
KCB_COMPANY_CODE=issued_by_kcb
KCB_FUNDS_TRANSFER_TRANSACTION_TYPE=IF
KCB_FUNDS_TRANSFER_PATH=/fundstransfer/1.0.0/api/v1/transfer
KCB_IPN_PATH=/ipn/1.0.0
KCB_MPESA_EXPRESS_PATH=/mm/api/request/1.0.0
KCB_MPESA_ROUTE_CODE=207
KCB_MPESA_OPERATION=STKPush
KCB_TRANSFER_STATUS_PATH=/kcb/bi/ips/p2p/transfer/status/inquiry/1.0.0
KCB_STATUS_POLL_INITIAL_DELAY_SECONDS=120
KCB_STATUS_POLL_MAX_ATTEMPTS=5
KCB_STATUS_EXCEPTION_AFTER_MINUTES=60
KCB_RECONCILIATION_WORKER_SECRET=generate_a_long_random_secret
KCB_PUBLIC_KEY_PATH=config/kcb_public_key.pem
KCB_VERIFY_CALLBACK_SIGNATURE=false

# Upload paths (leave as 'uploads' for relative, or absolute path for production)
UPLOAD_PATH=uploads
ATTENDANCE_WORKER_SECRET=replace_with_a_long_random_secret
ATTENDANCE_GATE_SECRET=replace_with_a_long_random_secret
