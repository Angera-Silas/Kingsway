# Kingsway realtime gateway — environment template for the APP ROOT.
#
# Place this file as `.env` next to app.js in the Passenger app root on the
# server (e.g. /home/<user>/realtime_app/.env) — the docroot is NOT the app
# root on shared hosting. The gateway reads it natively (src/config.js);
# real environment variables (panel-provided) always win over file values,
# so this file fills any variable the panel fails to deliver.
#
# Never commit real values. This template holds placeholders only.
#
# Must be byte-identical to the PHP application's JWT_SECRET (config/.env on
# the PHP side) — the gateway verifies PHP-minted capability JWTs with it.
JWT_SECRET=change-me-min-32-chars-shared-with-php

# Shared background-worker secret (PHP/Python -> Node /internal/publish).
# Either this key or KINGSWAY_WORKER_SECRET with the same value PHP holds.
KINGSWAY_WORKER_SECRET=change-me-min-32-chars-shared-with-php

# Browser origins allowed to open the SSE stream (the PHP site, NOT this
# gateway's own URL). Comma-separated. REQUIRED in production: without it
# the browser never receives Access-Control-Allow-Origin and every stream
# is blocked by CORS while the gateway itself looks healthy.
NODE_REALTIME_WEB_ORIGIN=https://kingswaypreparatoryschool.sc.ke

# Production deployment marker (pino level, metrics defaults, and the
# production requirement that the origin allowlist be non-empty).
NODE_ENV=production

# Optional extras (defaults are fine):
# NODE_REALTIME_JOURNAL=off        # silence the stdout journal in maintenance windows
# NODE_REALTIME_MAX_CONNECTIONS=5000
# NODE_REALTIME_HEARTBEAT_MS=20000
