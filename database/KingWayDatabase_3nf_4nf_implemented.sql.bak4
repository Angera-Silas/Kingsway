-- ------------------------------------------------------------
INSERT INTO `assessment_rubrics` (`id`, `tool_id`, `criteria_name`, `level_1_descriptor`, `level_2_descriptor`, `level_3_descriptor`, `level_4_descriptor`, `points_per_level`, `sort_order`, `created_at`) VALUES
  (1, 323, 'Understanding of Concepts', 'Learns the key concepts with difficulty and requires consistent support.', 'Understands the key concepts partially and applies them with guidance.', 'Understands and applies the key concepts correctly and independently.', 'Masters the key concepts and applies them accurately in new situations.', 4, 1, '2026-07-31 13:10:40'),
  (2, 323, 'Demonstration of Skills', 'Demonstrates the skill rarely and needs step-by-step assistance.', 'Demonstrates the skill sometimes and completes tasks with prompts.', 'Demonstrates the skill consistently and completes tasks independently.', 'Demonstrates the skill confidently, accurately, and creatively.', 4, 2, '2026-07-31 13:10:40'),
  (3, 323, 'Critical Thinking & Problem Solving', 'Shows limited ability to identify problems or make decisions.', 'Identifies problems with support and tries simple solutions.', 'Analyses problems, makes sound decisions, and solves them independently.', 'Analyses problems critically and devises creative solutions in new contexts.', 4, 3, '2026-07-31 13:10:40'),
  (4, 323, 'Creativity & Innovation', 'Follows given ideas only and produces work with much assistance.', 'Adds a few of their own ideas to given tasks with encouragement.', 'Produces original ideas and applies them to tasks independently.', 'Generates novel, original ideas and applies them resourcefully.', 4, 4, '2026-07-31 13:10:40'),
  (5, 323, 'Collaboration & Communication', 'Works alone most of the time and communicates ideas unclearly.', 'Shares tasks when reminded and communicates ideas partially.', 'Collaborates well with others and communicates ideas clearly.', 'Leads collaboration respectfully and communicates ideas persuasively.', 4, 5, '2026-07-31 13:10:40'),
