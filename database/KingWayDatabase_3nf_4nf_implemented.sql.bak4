  `date` date,
  `time_slot_id` int(10) UNSIGNED,
  `room_id` varchar(20),
  `notes` text,
  `status` enum('assigned','confirmed','completed') NOT NULL DEFAULT 'assigned',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_supervision_exam_staff_role` (`exam_schedule_id`, `staff_id`, `role`),
  KEY `idx_supervision_rosters_staff_id` (`staff_id`)
  KEY `idx_supervision_rosters_time_slot_id` (`time_slot_id`)
  KEY `idx_supervision_rosters_room_id` (`room_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='exam supervision roster (NEW) — from exam_schedules'
;

-- ------------------------------------------------------------
-- DDL: teaching_materials (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `teaching_materials` (
  `id` int(10) UNSIGNED,
  `academic_year_id` int(10) UNSIGNED,
  `academic_year_term_id` int(10) UNSIGNED,
  `academic_year_class_stream_id` int(10) UNSIGNED,
  `learning_area_id` int(10) UNSIGNED,
  `teacher_id` int(10) UNSIGNED,
  `resource_type` varchar(50),
  `access_scope` enum('private','subject','school','public') DEFAULT 'school',
  `status` enum('pending','approved','rejected') DEFAULT 'pending',
  `file_path` varchar(255),
  `file_name` varchar(255),
  `file_type` varchar(100),
  `file_size` int(10) UNSIGNED,
  `uploaded_by` int(10) UNSIGNED,
  `uploaded_at` datetime,
  `title` varchar(255),
  `description` text,
  `download_count` int(10) UNSIGNED DEFAULT 0,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_teaching_materials_academic_year_id` (`academic_year_id`)
  KEY `idx_teaching_materials_academic_year_term_id` (`academic_year_term_id`)
  KEY `idx_teaching_materials_academic_year_class_stream_id` (`academic_year_class_stream_id`)
  KEY `idx_teaching_materials_learning_area_id` (`learning_area_id`)
  KEY `idx_teaching_materials_teacher_id` (`teacher_id`)
  KEY `idx_teaching_materials_status` (`status`)
  KEY `idx_teaching_materials_created_at` (`created_at`)
  KEY `idx_teaching_materials_updated_at` (`updated_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
;

-- ------------------------------------------------------------
-- DDL: timetable_changes (transform)
