  `kra_pin` varchar(30) DEFAULT NULL,
  `nssf_no` varchar(30) DEFAULT NULL,
  `nhif_no` varchar(30) DEFAULT NULL,
  `status` enum('draft','active','inactive') NOT NULL DEFAULT 'draft',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `staff_id` (`staff_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
-- DDL: staff_probation_reviews (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `staff_probation_reviews` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `onboarding_id` int(10) UNSIGNED NOT NULL,
  `staff_id` int(10) UNSIGNED NOT NULL,
  `review_month` tinyint(4) NOT NULL COMMENT '1, 2, 3 (or more if extended)',
  `review_date` date NOT NULL,
  `reviewer_id` int(10) UNSIGNED DEFAULT NULL,
  `overall_rating` enum('unsatisfactory','needs_improvement','satisfactory','good','excellent') DEFAULT NULL,
  `attendance_score` decimal(5,2) DEFAULT NULL,
  `performance_score` decimal(5,2) DEFAULT NULL,
  `conduct_score` decimal(5,2) DEFAULT NULL,
  `strengths` text DEFAULT NULL,
  `areas_to_improve` text DEFAULT NULL,
  `outcome` enum('continue','extend_probation','confirm_permanent','terminate') NOT NULL,
  `outcome_notes` text DEFAULT NULL,
  `next_review_date` date DEFAULT NULL,
  `staff_signature` tinyint(1) DEFAULT 0,
  `reviewer_signature` tinyint(1) DEFAULT 0,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `onboarding_id` (`onboarding_id`),
  KEY `staff_id` (`staff_id`),
  KEY `idx_staff_probation_reviews_reviewer_id` (`reviewer_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------
-- DDL: staff_qualifications (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `staff_qualifications` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `staff_id` int(10) UNSIGNED NOT NULL,
  `qualification_type` enum('degree','diploma','certificate','other') NOT NULL,
  `title` varchar(255) NOT NULL,
  `institution` varchar(255) NOT NULL,
  `year_obtained` year(4) NOT NULL,
  `description` text DEFAULT NULL,
  `document_url` varchar(255) DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_staff` (`staff_id`),
  KEY `idx_year` (`year_obtained`)
) ENGINE=InnoDB AUTO_INCREMENT=37 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------
-- DDL: staff_salary_advances (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `staff_salary_advances` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `advance_number` varchar(30) NOT NULL,
  `staff_id` int(10) UNSIGNED NOT NULL,
  `requested_amount` decimal(12,2) NOT NULL,
  `approved_amount` decimal(12,2) DEFAULT NULL,
  `request_date` date NOT NULL,
  `reason` text DEFAULT NULL,
  `deduction_schedule` enum('single_month','two_months','three_months') DEFAULT 'single_month',
  `deduction_start_month` date DEFAULT NULL COMMENT 'First month payroll deduction applies (YYYY-MM-01)',
  `amount_per_deduction` decimal(12,2) DEFAULT NULL,
  `amount_deducted` decimal(12,2) DEFAULT 0.00,
  `balance_remaining` decimal(12,2) DEFAULT 0.00,
  `status` enum('pending','approved','rejected','active','fully_deducted','cancelled') DEFAULT 'pending',
  `approved_by` int(10) UNSIGNED DEFAULT NULL,
  `approval_date` datetime DEFAULT NULL,
  `rejection_reason` text DEFAULT NULL,
  `notes` text DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `advance_number` (`advance_number`),
  KEY `idx_staff` (`staff_id`),
  KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------
-- DDL: staff_shift_assignments (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `staff_shift_assignments` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `staff_id` int(10) UNSIGNED NOT NULL,
  `shift` enum('morning','afternoon','evening','night','full_day') NOT NULL DEFAULT 'full_day',
  `day_of_week` enum('Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday') NOT NULL,
  `start_time` time NOT NULL,
  `end_time` time NOT NULL,
  `effective_from` date NOT NULL,
  `effective_to` date DEFAULT NULL,
  `academic_year_id` int(10) UNSIGNED DEFAULT NULL,
  `assigned_by` int(10) UNSIGNED DEFAULT NULL,
  `notes` text DEFAULT NULL,
  `status` enum('active','inactive') DEFAULT 'active',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_staff` (`staff_id`),
  KEY `idx_year` (`academic_year_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------
-- DDL: staff_types (keep)
