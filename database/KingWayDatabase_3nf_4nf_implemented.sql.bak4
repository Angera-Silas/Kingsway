  PRIMARY KEY (`id`),
  KEY `idx_workflow_notify` (`instance_id`,`notification_type`),
  KEY `idx_user_notifications` (`user_id`,`is_read`)
) ENGINE=InnoDB AUTO_INCREMENT=15 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

