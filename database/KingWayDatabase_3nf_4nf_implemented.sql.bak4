-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `academic_year_class_learning_area_teachers` (
  `id` int(10) UNSIGNED,
  `academic_year_class_learning_area_id` int(10) UNSIGNED NOT NULL,
  `academic_year_term_id` int(10) UNSIGNED NOT NULL,
  `staff_id` int(10) UNSIGNED NOT NULL,
  `role` enum('subject_teacher','assistant','hod') NOT NULL DEFAULT 'subject_teacher',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_area_term_staff` (`academic_year_class_learning_area_id`, `academic_year_term_id`, `staff_id`, `role`),
  KEY `idx_academic_year_class_learning_area_teachers_academic_y6033` (`academic_year_term_id`)
  KEY `idx_academic_year_class_learning_area_teachers_staff_id` (`staff_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='teacher responsibility per term'
;

-- ------------------------------------------------------------
-- DDL: student_transitions (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `student_transitions` (
  `id` int(10) UNSIGNED,
  `student_id` int(10) UNSIGNED NOT NULL,
  `from_student_academic_enrollment_id` int(10) UNSIGNED,
  `to_student_academic_enrollment_id` int(10) UNSIGNED,
  `academic_year_id` int(10) UNSIGNED NOT NULL,
  `transition_type` varchar(20) NOT NULL,
  `reason` text,
  `decided_by` int(10) UNSIGNED,
  `decided_at` datetime,
  `executed_at` datetime,
  PRIMARY KEY (`id`),
  KEY `idx_student_transitions_student_id` (`student_id`)
  KEY `idx_student_transitions_from_student_academic_enrollment_id` (`from_student_academic_enrollment_id`)
  KEY `idx_student_transitions_to_student_academic_enrollment_id` (`to_student_academic_enrollment_id`)
  KEY `idx_student_transitions_academic_year_id` (`academic_year_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='promotion/retention/transfer/graduation history'
;

