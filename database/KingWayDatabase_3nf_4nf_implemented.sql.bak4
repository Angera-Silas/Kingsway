  KEY `idx_visibility` (`visibility`),
  KEY `idx_priority` (`priority`),
  KEY `idx_resolved` (`resolved`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

