    IF NEW.status = 'archived' AND OLD.status != 'archived' THEN
        UPDATE staff_class_assignments
        SET status = 'completed',
            end_date = NEW.end_date
        WHERE academic_year_id = NEW.id
        AND status = 'active';
    END IF;
END$$
