  `requires_attendance` tinyint(1) DEFAULT 1,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_day_type_code` (`code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='day type REF (NEW)'
;

-- ------------------------------------------------------------
-- DDL: academic_year_calendar (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `academic_year_calendar` (
  `id` int(10) UNSIGNED,
