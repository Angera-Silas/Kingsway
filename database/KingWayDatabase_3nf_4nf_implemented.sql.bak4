  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_year_class` (`academic_year_id`, `class_id`),
  KEY `idx_academic_year_classes_class_id` (`class_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='class-in-year context'
;

-- ------------------------------------------------------------
