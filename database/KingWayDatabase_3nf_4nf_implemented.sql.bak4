  `name` varchar(100) NOT NULL,
  `gender` enum('male','female','mixed') NOT NULL,
  `capacity` int(11) NOT NULL DEFAULT 50,
  `current_occupancy` int(11) DEFAULT 0,
  `floor_count` int(11) DEFAULT 1,
  `house_parent_id` int(10) UNSIGNED DEFAULT NULL COMMENT 'Staff member in charge',
  `assistant_house_parent_id` int(10) UNSIGNED DEFAULT NULL,
  `location` varchar(255) DEFAULT NULL,
  `facilities` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL COMMENT 'e.g., ["bathroom", "study_room", "common_room"]' CHECK (json_valid(`facilities`)),
  `status` enum('active','inactive','maintenance') DEFAULT 'active',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `code` (`code`),
  KEY `dormitories_ibfk_1` (`house_parent_id`),
  KEY `dormitories_ibfk_2` (`assistant_house_parent_id`)
) ENGINE=InnoDB AUTO_INCREMENT=7 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
-- DDL: equipment_maintenance (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `equipment_maintenance` (
