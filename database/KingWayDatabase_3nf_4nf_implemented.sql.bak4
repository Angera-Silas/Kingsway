  KEY `idx_dates` (`start_date`,`end_date`),
  KEY `idx_status` (`status`),
  KEY `student_permissions_ibfk_2` (`permission_type_id`),
  KEY `student_permissions_ibfk_3` (`parent_id`),
  KEY `student_permissions_ibfk_4` (`approved_by`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

