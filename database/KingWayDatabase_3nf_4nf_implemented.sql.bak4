  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_workflow_history_workflow_id` (`workflow_id`)
  KEY `idx_workflow_history_created_at` (`created_at`)
