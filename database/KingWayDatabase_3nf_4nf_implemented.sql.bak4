  `status` enum('pending','offered','accepted','declined') NOT NULL DEFAULT 'pending',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_placement_application` (`application_id`),
  KEY `idx_placement_offers_academic_year_class_stream_id` (`academic_year_class_stream_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='admission placement offer (NEW) — admission_placements/confirmations (empty)'
;

-- ------------------------------------------------------------
-- DDL: requisitions (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `requisitions` (
  `id` int(10) UNSIGNED,
  `requisition_number` varchar(30) NOT NULL,
  `department_id` int(10) UNSIGNED,
  `academic_year_id` int(10) UNSIGNED,
  `academic_year_term_id` int(10) UNSIGNED,
  `requisition_date` date NOT NULL,
  `required_date` date,
  `priority` enum('low','medium','high','urgent') NOT NULL DEFAULT 'medium',
  `status` enum('pending','approved','fulfilled','rejected','cancelled') NOT NULL DEFAULT 'pending',
  `requested_by` int(10) UNSIGNED,
  `approved_by` int(10) UNSIGNED,
  `approved_at` datetime,
  `rejection_reason` text,
  `fulfilled_at` datetime,
  `notes` text,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_requisition_number` (`requisition_number`),
  KEY `idx_requisitions_department_id` (`department_id`)
  KEY `idx_requisitions_academic_year_id` (`academic_year_id`)
  KEY `idx_requisitions_academic_year_term_id` (`academic_year_term_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='stock requisition master (NEW) — from inventory_requisitions (empty)'
;

-- ------------------------------------------------------------
-- DDL: routes_registry (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `routes_registry` (
  `id` int(10) UNSIGNED,
  `name` varchar(100) NOT NULL,
  `url` varchar(255) NOT NULL,
  `domain` enum('SYSTEM','SCHOOL') NOT NULL DEFAULT 'SCHOOL',
  `module` varchar(100),
  `description` varchar(500),
  `controller` varchar(255),
  `action` varchar(100),
  `is_active` tinyint(1) NOT NULL DEFAULT 1,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_route_name` (`name`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
;

-- ------------------------------------------------------------
-- DDL: scheme_template_learning_outcomes (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `scheme_template_learning_outcomes` (
  `scheme_template_id` int(10) UNSIGNED NOT NULL,
  `learning_outcome_id` int(10) UNSIGNED NOT NULL,
  PRIMARY KEY (`scheme_template_id`, `learning_outcome_id`),
  KEY `idx_scheme_template_learning_outcomes_learning_outcome_id` (`learning_outcome_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='outcomes selected for a scheme template (NEW)'
;

-- ------------------------------------------------------------
-- DDL: scheme_templates (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `scheme_templates` (
  `id` int(10) UNSIGNED,
  `learning_area_id` int(10) UNSIGNED NOT NULL,
  `strand_id` int(10) UNSIGNED,
  `sub_strand_id` int(10) UNSIGNED,
  `title` varchar(200) NOT NULL,
  `activities` text,
  `resources` text,
  `assessment_methods` text,
  `created_by` int(10) UNSIGNED,
  `is_shared` tinyint(1) DEFAULT 0,
  `status` enum('draft','approved','archived') NOT NULL DEFAULT 'draft',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_template_area_strand_substrand_title` (`learning_area_id`, `strand_id`, `sub_strand_id`, `title`),
  KEY `idx_scheme_templates_strand_id` (`strand_id`)
  KEY `idx_scheme_templates_sub_strand_id` (`sub_strand_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='reusable scheme content master (NEW) — from schemes_of_work'
;

-- ------------------------------------------------------------
-- DDL: schemes_of_work (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `schemes_of_work` (
  `id` int(10) UNSIGNED,
  `scheme_template_id` int(10) UNSIGNED NOT NULL,
  `academic_year_class_learning_area_id` int(10) UNSIGNED,
  `academic_year_calendar_week_id` int(10) UNSIGNED,
  `teacher_id` int(10) UNSIGNED NOT NULL,
  `status` enum('draft','approved','archived') NOT NULL DEFAULT 'draft',
  `approved_by` int(10) UNSIGNED,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_scheme_context_week_template` (`academic_year_class_learning_area_id`, `academic_year_calendar_week_id`, `scheme_template_id`),
  KEY `idx_schemes_of_work_scheme_template_id` (`scheme_template_id`)
  KEY `idx_schemes_of_work_academic_year_calendar_week_id` (`academic_year_calendar_week_id`)
  KEY `idx_schemes_of_work_teacher_id` (`teacher_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='scheme-of-work year-instance (reshaped) — from legacy schemes_of_work'
;

-- ------------------------------------------------------------
-- DDL: school_events (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `school_events` (
  `id` int(10) UNSIGNED,
  `title` varchar(255) NOT NULL,
  `description` text,
  `start_at` datetime NOT NULL,
  `end_at` datetime,
  `type` varchar(50) NOT NULL,
  `location` varchar(200),
  `status` enum('upcoming','ongoing','past','cancelled') NOT NULL DEFAULT 'upcoming',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_event_date` (`start_at`, `status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
;

-- ------------------------------------------------------------
-- DDL: staff_attendance (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `staff_attendance` (
  `id` int(10) UNSIGNED,
  `staff_id` int(10) UNSIGNED NOT NULL,
  `date` date NOT NULL,
  `academic_year_id` int(10) UNSIGNED,
  `status` enum('present','absent','late') NOT NULL,
  `check_in` time,
  `check_out` time,
  `duty_type_id` int(10) UNSIGNED,
  `leave_id` int(10) UNSIGNED,
  `absence_reason` enum('leave','sick','off_day','unauthorized','other'),
  `notes` text,
  `marked_by` int(10) UNSIGNED,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_staff_date` (`staff_id`, `date`),
  KEY `idx_staff_date` (`staff_id`, `date`),
  KEY `idx_staff_attendance_academic_year_id` (`academic_year_id`)
  KEY `idx_staff_attendance_duty_type_id` (`duty_type_id`)
  KEY `idx_staff_attendance_leave_id` (`leave_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
;

-- ------------------------------------------------------------
-- DDL: staff_department_assignments (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `staff_department_assignments` (
  `id` int(10) UNSIGNED,
  `staff_id` int(10) UNSIGNED NOT NULL,
  `department_id` int(10) UNSIGNED NOT NULL,
  `role` varchar(30),
  `effective_from` date,
  `effective_to` date,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_staff_dept_from` (`staff_id`, `department_id`, `effective_from`),
  KEY `idx_staff_department_assignments_department_id` (`department_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='staff-department binding (NEW) — from staff_employment_profiles (empty)'
;

-- ------------------------------------------------------------
-- DDL: student_attendance (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `student_attendance` (
  `id` int(10) UNSIGNED,
  `student_academic_enrollment_id` int(10) UNSIGNED NOT NULL,
  `date` date NOT NULL,
  `session_id` int(10) UNSIGNED,
  `status` enum('present','absent','late') NOT NULL,
  `check_in_time` time,
  `check_out_time` time,
  `absence_reason` enum('unexcused','sick','permission','suspension','other') DEFAULT 'unexcused',
  `permission_id` int(10) UNSIGNED,
  `notes` text,
  `register_type` enum('class','boarding','activity') NOT NULL DEFAULT 'class',
  `marked_by` int(10) UNSIGNED,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_attendance_mark` (`student_academic_enrollment_id`, `date`, `session_id`, `register_type`),
  KEY `idx_enr_date` (`student_academic_enrollment_id`, `date`),
  KEY `idx_student_attendance_session_id` (`session_id`)
  KEY `idx_student_attendance_permission_id` (`permission_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
;

-- ------------------------------------------------------------
-- DDL: student_fee_obligations (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `student_fee_obligations` (
  `id` int(10) UNSIGNED,
  `student_academic_enrollment_id` int(10) UNSIGNED NOT NULL,
  `academic_year_id` int(10) UNSIGNED NOT NULL,
  `academic_year_term_id` int(10) UNSIGNED NOT NULL,
  `academic_year_fee_schedule_id` int(10) UNSIGNED NOT NULL,
  `amount_due` decimal(12,2) NOT NULL,
  `status` enum('pending','partial','paid','arrears') NOT NULL DEFAULT 'pending',
  `due_date` date,
  `is_sponsored` tinyint(1) DEFAULT 0,
  `sponsored_waiver_amount` decimal(12,2) DEFAULT 0.00,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_student_obligation` (`student_academic_enrollment_id`, `academic_year_id`, `academic_year_term_id`, `academic_year_fee_schedule_id`),
  KEY `idx_status` (`status`),
  KEY `idx_due_date` (`due_date`),
  KEY `idx_student_fee_obligations_academic_year_id` (`academic_year_id`)
  KEY `idx_student_fee_obligations_academic_year_term_id` (`academic_year_term_id`)
  KEY `idx_student_fee_obligations_academic_year_fee_schedule_id` (`academic_year_fee_schedule_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
;

-- ------------------------------------------------------------
-- DDL: supervision_rosters (transform)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `supervision_rosters` (
  `id` int(10) UNSIGNED,
