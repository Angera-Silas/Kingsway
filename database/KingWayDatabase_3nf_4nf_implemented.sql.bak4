  KEY `idx_timetable_entries_teacher_id` (`teacher_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='timetable fact rows (NEW) — class_schedules/timetable_templates (empty)'
;

