  `week_number` int(10) UNSIGNED NOT NULL,
  `week_start` date NOT NULL,
  `week_end` date NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_term_week` (`academic_year_term_id`, `week_number`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='dated week grid'
;

-- ------------------------------------------------------------
-- DDL: academic_year_calendar_days (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `academic_year_calendar_days` (
  `id` int(10) UNSIGNED,
