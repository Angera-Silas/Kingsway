  KEY `idx_subject_time_allocations_academic_year_id` (`academic_year_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Periods per week per subject per class — basis for timetable generation';

