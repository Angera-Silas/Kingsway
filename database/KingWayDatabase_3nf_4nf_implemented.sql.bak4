-- Setup & database
-- ------------------------------------------------------------
SET @OLD_SQL_MODE=@@SQL_MODE, SQL_MODE='NO_AUTO_VALUE_ON_ZERO';
SET FOREIGN_KEY_CHECKS=0;
SET UNIQUE_CHECKS=0;
SET NAMES utf8mb4;

DROP DATABASE IF EXISTS `KingWayAcademy3nf`;
CREATE DATABASE `KingWayAcademy3nf` DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE `KingWayAcademy3nf`;

-- ------------------------------------------------------------
-- DDL: persons (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `persons` (
  `id` int(10) UNSIGNED,
  `first_name` varchar(50) NOT NULL,
  `middle_name` varchar(50),
  `last_name` varchar(50) NOT NULL,
  `dob` date,
  `gender` enum('male','female','other'),
  `national_id_no` varchar(30),
  `photo_url` varchar(255),
  `email` varchar(100),
  `phone` varchar(20),
  PRIMARY KEY (`id`),
  KEY `idx_persons_email` (`email`)
  KEY `idx_persons_phone` (`phone`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='shared identity base (4NF)'
;

-- ------------------------------------------------------------
-- DDL: users (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `users` (
  `id` int(10) UNSIGNED,
  `person_id` int(10) UNSIGNED,
  `username` varchar(50) NOT NULL,
  `password_hash` varchar(255) NOT NULL,
  `status` enum('active','inactive','suspended','pending') NOT NULL DEFAULT 'pending',
  `last_login` datetime,
  `password_changed_at` datetime,
  `failed_login_attempts` int(10) UNSIGNED DEFAULT 0,
  `account_locked_until` timestamp,
  `password_expires_at` timestamp,
  `force_password_change` tinyint(1) DEFAULT 0,
  `is_test_user` tinyint(1) DEFAULT 0,
  `two_factor_secret` varchar(255),
  `two_factor_enabled` tinyint(1) DEFAULT 0,
  `two_factor_method` enum('totp','email','sms','none'),
  `two_factor_verified_at` datetime,
  `backup_codes_generated_at` datetime,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_username` (`username`),
  UNIQUE KEY `uk_users_person` (`person_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='account (not a person copy)'
;

-- ------------------------------------------------------------
-- DDL: students (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `students` (
  `id` int(10) UNSIGNED,
  `person_id` int(10) UNSIGNED,
  `admission_no` varchar(20) NOT NULL,
  `student_type_id` int(10) UNSIGNED,
  `assessment_number` varchar(50),
  `assessment_status` enum('not_assigned','pending','assigned','verified','transferred') NOT NULL DEFAULT 'not_assigned',
  `nemis_number` varchar(20),
  `nemis_status` enum('not_assigned','pending','assigned','verified') NOT NULL DEFAULT 'not_assigned',
  `status` enum('active','inactive','graduated','transferred','suspended') NOT NULL DEFAULT 'active',
  `application_id` int(10) UNSIGNED,
  `admission_date` date NOT NULL,
  `blood_group` varchar(10),
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_admission_no` (`admission_no`),
  UNIQUE KEY `uk_students_person` (`person_id`),
  KEY `idx_students_student_type_id` (`student_type_id`)
  KEY `idx_students_application_id` (`application_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='learner subtype'
;

-- ------------------------------------------------------------
-- DDL: staff (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `staff` (
  `id` int(10) UNSIGNED,
  `person_id` int(10) UNSIGNED,
  `staff_no` varchar(20) NOT NULL,
  `staff_type_id` int(10) UNSIGNED,
  `staff_category_id` int(10) UNSIGNED,
  `position` varchar(100),
  `contract_type` enum('permanent','contract','temporary') NOT NULL DEFAULT 'permanent',
  `employment_date` date NOT NULL,
  `status` enum('active','inactive','on_leave') NOT NULL DEFAULT 'active',
  `supervisor_id` int(10) UNSIGNED,
  `salary` decimal(12,2),
  `bank_name` varchar(100),
  `bank_account` varchar(50),
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_staff_no` (`staff_no`),
  UNIQUE KEY `uk_staff_person` (`person_id`),
  KEY `idx_staff_staff_type_id` (`staff_type_id`)
  KEY `idx_staff_staff_category_id` (`staff_category_id`)
  KEY `idx_staff_supervisor_id` (`supervisor_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='employee subtype'
;

-- ------------------------------------------------------------
-- DDL: parents (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `parents` (
  `id` int(10) UNSIGNED,
  `person_id` int(10) UNSIGNED,
  `occupation` varchar(100),
  `address` text,
  `status` enum('active','inactive') NOT NULL DEFAULT 'active',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_parents_person` (`person_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='guardian subtype'
;

-- ------------------------------------------------------------
-- DDL: student_parents (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `student_parents` (
  `student_id` int(10) UNSIGNED NOT NULL,
  `parent_id` int(10) UNSIGNED NOT NULL,
  `relationship` varchar(20),
  `is_primary_contact` tinyint(1) NOT NULL DEFAULT 0,
  `is_emergency_contact` tinyint(1) NOT NULL DEFAULT 0,
  PRIMARY KEY (`student_id`, `parent_id`),
  KEY `idx_student_parents_parent_id` (`parent_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='guardian relation (4NF)'
;

-- ------------------------------------------------------------
-- DDL: classes (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `classes` (
  `id` int(10) UNSIGNED,
  `code` varchar(20) NOT NULL,
  `name` varchar(50) NOT NULL,
  `level_id` int(10) UNSIGNED NOT NULL,
  `grade_level` varchar(20),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_class_code` (`code`),
  UNIQUE KEY `uk_class_name` (`name`),
  KEY `idx_classes_level_id` (`level_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='class master'
;

-- ------------------------------------------------------------
-- DDL: streams (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `streams` (
  `id` int(10) UNSIGNED,
  `name` varchar(50) NOT NULL,
  `code` varchar(20) NOT NULL,
  `capacity` int(10) UNSIGNED DEFAULT 40,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_stream_name` (`name`),
  UNIQUE KEY `uk_stream_code` (`code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='stream master'
;

-- ------------------------------------------------------------
-- DDL: terms (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `terms` (
  `id` int(10) UNSIGNED,
  `name` varchar(50) NOT NULL,
  `code` varchar(20) NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_term_name` (`name`),
  UNIQUE KEY `uk_term_code` (`code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='term master (Term 1/2/3)'
;

-- ------------------------------------------------------------
-- DDL: academic_years (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `academic_years` (
  `id` int(10) UNSIGNED,
  `year_code` varchar(20) NOT NULL,
  `year_name` varchar(100) NOT NULL,
  `start_date` date NOT NULL,
  `end_date` date NOT NULL,
  `status` enum('planning','registration','active','closing','archived') NOT NULL DEFAULT 'planning',
  `is_current` tinyint(1) DEFAULT 0,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_year_code` (`year_code`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='academic year master'
;

-- ------------------------------------------------------------
-- DDL: academic_year_terms (spine)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `academic_year_terms` (
  `id` int(10) UNSIGNED,
  `academic_year_id` int(10) UNSIGNED NOT NULL,
  `term_id` int(10) UNSIGNED NOT NULL,
  `opening_date` date,
  `half_term_start` date,
  `half_term_end` date,
  `closing_date` date,
  `status` enum('upcoming','current','completed') NOT NULL DEFAULT 'upcoming',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_year_term` (`academic_year_id`, `term_id`),
  KEY `idx_academic_year_terms_term_id` (`term_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='term-in-year instance'
;

-- ------------------------------------------------------------
