-- ------------------------------------------------------------
-- DDL: workflow_stage_permissions (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `workflow_stage_permissions` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
