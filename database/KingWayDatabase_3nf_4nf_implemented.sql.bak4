  UNIQUE KEY `uq_stage_perm_role` (`workflow_stage_id`,`permission_id`,`role_id`),
  KEY `permission_id` (`permission_id`),
  KEY `role_id` (`role_id`)
) ENGINE=InnoDB AUTO_INCREMENT=186 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

-- ------------------------------------------------------------
-- DDL: workflow_stages (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `workflow_stages` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `workflow_id` int(10) UNSIGNED NOT NULL,
  `code` varchar(50) NOT NULL,
  `name` varchar(100) NOT NULL,
  `required_permission` varchar(255) DEFAULT NULL COMMENT 'Permission required to enter this stage',
  `responsible_role_ids` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL COMMENT 'Roles responsible for this stage' CHECK (json_valid(`responsible_role_ids`)),
  `description` text DEFAULT NULL,
  `sequence` int(11) NOT NULL COMMENT 'Order of stages',
  `required_role` varchar(50) DEFAULT NULL COMMENT 'Role required to process this stage',
  `allowed_transitions` longtext NOT NULL COMMENT 'Array of possible next stage codes' CHECK (json_valid(`allowed_transitions`)),
  `action_config` longtext DEFAULT NULL COMMENT 'Required actions config' CHECK (json_valid(`action_config`)),
  `timeout_hours` int(11) DEFAULT NULL COMMENT 'Stage timeout in hours',
  `is_active` tinyint(1) NOT NULL DEFAULT 1,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_workflow_stage` (`workflow_id`,`code`),
  KEY `idx_workflow_sequence` (`workflow_id`,`sequence`)
) ENGINE=InnoDB AUTO_INCREMENT=1042 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
-- DDL: route_permissions (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `route_permissions` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `route_id` int(10) UNSIGNED NOT NULL,
  `permission_id` int(11) NOT NULL COMMENT 'Matches permissions.id (signed int)',
  `access_type` enum('view','create','update','delete','approve','manage','all') NOT NULL DEFAULT 'view' COMMENT 'Type of access this permission grants',
  `is_required` tinyint(1) NOT NULL DEFAULT 1 COMMENT 'If TRUE, permission is mandatory; if FALSE, its optional (OR logic)',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_route_permission_access` (`route_id`,`permission_id`,`access_type`),
  KEY `fk_route_permissions_permission` (`permission_id`)
) ENGINE=InnoDB AUTO_INCREMENT=133107 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

