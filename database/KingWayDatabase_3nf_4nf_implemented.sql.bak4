-- ------------------------------------------------------------
-- DDL: strands (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `strands` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
  `learning_area_id` int(10) UNSIGNED NOT NULL,
  `grade_level` varchar(20) NOT NULL DEFAULT '' COMMENT 'e.g. PP1, Grade 5',
  `code` varchar(20) NOT NULL,
  `name` varchar(150) NOT NULL,
  `variant` varchar(20) DEFAULT NULL COMMENT 'RE variant: CRE|IRE|HRE',
  `source_subject` varchar(100) DEFAULT NULL COMMENT '2024 source subject (e.g. Home Science)',
  `source_document` varchar(255) DEFAULT NULL COMMENT 'KICD design PDF filename',
  `source_page` varchar(20) DEFAULT NULL,
  `is_optional` tinyint(1) NOT NULL DEFAULT 0,
  `description` text DEFAULT NULL,
  `level_range` varchar(50) DEFAULT NULL COMMENT 'e.g. G1-G3, G4-G6, G7-G9',
  `sort_order` smallint(5) UNSIGNED NOT NULL DEFAULT 1,
  `status` enum('active','inactive') NOT NULL DEFAULT 'active',
  `created_at` datetime NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_strand_grade` (`learning_area_id`,`grade_level`,`name`,`variant`),
  KEY `idx_strand_la` (`learning_area_id`),
  KEY `idx_strand_grade` (`grade_level`)
) ENGINE=InnoDB AUTO_INCREMENT=1109 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
-- DDL: student_boarding_notes (keep)
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS `student_boarding_notes` (
  `id` int(10) UNSIGNED NOT NULL AUTO_INCREMENT,
