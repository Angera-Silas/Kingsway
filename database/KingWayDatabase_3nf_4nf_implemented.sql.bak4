INSERT INTO `onboarding_task_templates` (`id`, `template_code`, `task_name`, `description`, `category`, `applies_to_type_ids`, `days_from_start`, `priority`, `responsible_role`, `is_mandatory`, `display_order`, `status`, `created_at`) VALUES
  (1, 'DOC_NATIONAL_ID', 'National ID / Passport copy', 'Collect certified copy of National ID or Passport', 'documentation', NULL, 1, 'high', 'hr', 1, 10, 'active', '2026-04-25 19:00:47'),
  (2, 'DOC_KRA_PIN', 'KRA PIN Certificate', 'Collect and verify KRA PIN certificate for PAYE', 'documentation', NULL, 1, 'high', 'hr', 1, 20, 'active', '2026-04-25 19:00:47'),
