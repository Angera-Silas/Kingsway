  KEY `idx_timetable_changes_new_teacher_id` (`new_teacher_id`)
  KEY `idx_timetable_changes_status` (`status`)
  KEY `idx_timetable_changes_created_at` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='timetable change requests (NEW) — schedule_changes (empty)'
