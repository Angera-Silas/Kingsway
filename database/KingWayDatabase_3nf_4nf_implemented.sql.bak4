        VALUES (
            NULL,
            'UPDATE',
            'inventory_allocations',
            NEW.id,
            JSON_OBJECT('status', OLD.status),
            JSON_OBJECT(
                'status', NEW.status,
                'allocation_number', NEW.allocation_number
            ),
            NOW()
        );
    END IF;
END$$
