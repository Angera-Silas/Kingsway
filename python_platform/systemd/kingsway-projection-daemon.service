[Unit]
Description=Kingsway Real-time Projection Refresh Daemon
After=mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/prof_angera/Projects/php_pages/Kingsway/python_platform

# Environment
Environment="KINGSWAY_DB_HOST=127.0.0.1"
Environment="KINGSWAY_DB_PORT=3306"
Environment="KINGSWAY_DB_USER=root"
Environment="KINGSWAY_DB_PASSWORD=admin123"
Environment="KINGSWAY_DB_MASTER_SCHEMA=KingsWayAcademy"
Environment="KINGSWAY_DB_READS_SCHEMA=KingsWayReads"
Environment="KINGSWAY_PYTHON_READ_MODELS_ENABLED=true"

# Command
ExecStart=/home/prof_angera/Projects/php_pages/Kingsway/python_platform/scripts/start_daemon.sh
Restart=always
RestartSec=5

# Security
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target